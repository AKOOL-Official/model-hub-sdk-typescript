{
  "name": "@akool/modelhub-sdk",
  "version": "0.1.0",
  "description": "AKOOL Model Hub SDK for Node.js and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
